# Copy to .env or export in your shell. Never commit real values.
PHONE_CHAT_SECRET=replace-with-a-long-random-string
# PHONE_CHAT_PORT=8787
# Free self-signed HTTPS for live iPhone mic (default = HTTP port + 1 → 8788)
# PHONE_CHAT_HTTPS_PORT=8788
# PHONE_CHAT_TLS=0
# Extra DNS names on the cert SAN (MagicDNS, custom hostnames)
# PHONE_CHAT_TLS_HOSTS=mac.tailnet-name.ts.net
# PHONE_CHAT_HOST=0.0.0.0
# PHONE_CHAT_CWD=/path/to/your/workspace
# GROK_BIN=grok
# PHONE_CHAT_DEBUG=1
# Hang recovery: no message/tool progress for this long (default 90000 = 90s)
# PHONE_CHAT_JOB_IDLE_TIMEOUT_MS=90000
# PHONE_CHAT_JOB_TIMEOUT_MS=2700000
# PHONE_CHAT_MAX_BODY_BYTES=12582912
# Opt-in: allow ACP fs tools under entire home directory
# PHONE_CHAT_ALLOW_HOME=1
# Extra ACP fs roots (:, ;, or , separated)
# PHONE_CHAT_FS_ROOTS=/path/to/extra
